---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../lib/content";
---

<BaseLayout title="Selected work" description="Selected public products and prototypes by Miguel Salazar, with explicit proof states and limits.">
  <header class="page-hero">
    <div class="shell page-hero__grid">
      <div>
        <p class="eyebrow">Index / public work</p>
        <h1>Selected work.</h1>
      </div>
      <div class="page-hero__copy">
        <p>
          Systems across civic access, health, and consumer experience. The index is
          intentionally small: fewer projects, clearer roles, honest evidence.
        </p>
      </div>
    </div>
  </header>

  <section aria-label="Project index">
    <div class="shell work-list">
      {projects.map((project, index) => (
        <a class="work-row" href={`/work/${project.slug}/`}>
          <span class="work-row__number">{String(index + 1).padStart(2, "0")}</span>
          <h2>{project.title}</h2>
          <p>{project.summary}</p>
          <span class="work-row__meta">{project.status} ↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
