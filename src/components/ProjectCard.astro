---
import type { Project } from "../lib/content";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<article class="project-card">
  <a class="project-card__visual-link" href={`/work/${project.slug}/`} aria-label={`Read the ${project.title} case study`}>
    <ProjectVisual visual={project.visual} title={project.title} />
  </a>
  <div class="project-card__body">
    <div class="project-card__index">
      <span>{String(index + 1).padStart(2, "0")}</span>
      <span>{project.status}</span>
    </div>
    <p class="eyebrow">{project.eyebrow}</p>
    <h3><a href={`/work/${project.slug}/`}>{project.title}</a></h3>
    <p>{project.summary}</p>
    <ul class="tag-list" aria-label={`${project.title} disciplines`}>
      {project.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
    </ul>
    <a class="text-link" href={`/work/${project.slug}/`}>
      Read case study <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
